---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
---

<BaseLayout
  title="Questions fréquentes (FAQ) | Camille Durand — Pédicure-Podologue à Toulon"
  description="Réponses aux questions pratiques : durée d'un soin, documents à apporter et conditions des soins à domicile."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: "Faut-il une ordonnance pour consulter un pédicure-podologue ?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Pour toute question sur l'ordonnance ou sur la prise en charge, merci de contacter le cabinet lors de la prise de rendez-vous."
        }
      },
      {
        '@type': 'Question',
        name: "Que faut-il apporter lors d'un bilan podologique ?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Merci de vous munir de vos chaussures habituelles et de tout document utile à votre venue."
        }
      },
      {
        '@type': 'Question',
        name: "Combien de temps dure une séance ?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Un soin de pédicurie dure environ 45 minutes. Un bilan podologique complet nécessite entre 45 et 60 minutes."
        }
      },
      {
        '@type': 'Question',
        name: "Comment se déroule la confection des orthèses plantaires ?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Les orthèses plantaires sont fabriquées au sein de l'atelier du cabinet suite au bilan podologique. Un rendez-vous de remise et d'essayage est fixé dans un délai de 7 à 10 jours, suivi d'une consultation de contrôle qui peut être proposée pour vérifier l'adaptation."
        }
      },
      {
        '@type': 'Question',
        name: "Quelles sont les conditions pour un soin à domicile ?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Les soins à domicile sont strictement réservés aux personnes à mobilité réduite ou en incapacité physique de déplacement sur la commune de Toulon. La prise de rendez-vous se fait uniquement par téléphone."
        }
      },
      {
        '@type': 'Question',
        name: "Le cabinet est-il accessible aux personnes en fauteuil roulant ?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Oui. Le cabinet est situé au rez-de-chaussée, avec un accès de plain-pied."
        }
      }
    ]
  }}
>
  <section class="py-12 md:py-20 bg-background border-b border-border" data-ps="src/pages/faq.astro:tnsbcj">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8" data-ps="src/pages/faq.astro:aapkxf">
      <div class="max-w-3xl space-y-4" data-ps="src/pages/faq.astro:2mg1wl">
        <h1 class="font-serif text-h1 font-bold text-foreground m-0" data-ps="src/pages/faq.astro:ksdz2a">
          Questions fréquentes
        </h1>
        <p class="text-lg md:text-xl text-muted-foreground leading-relaxed m-0" data-ps="src/pages/faq.astro:3y7144">
          Informations pratiques pour préparer votre consultation au cabinet de pédicurie-podologie.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-surface" data-ps="src/pages/faq.astro:tnsbck">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8" data-ps="src/pages/faq.astro:2mg1wk">
      <div class="max-w-3xl mx-auto space-y-6" data-ps="src/pages/faq.astro:2mg1wj">
        
        <!-- Q1 -->
        <div class="p-6 bg-background border border-border rounded-xs space-y-2" data-ps="src/pages/faq.astro:2mg1wi">
          <h2 class="font-serif text-lg font-bold text-foreground m-0" data-ps="src/pages/faq.astro:63z1ty">
            Faut-il une ordonnance pour consulter ?
          </h2>
          <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/faq.astro:3y7145">
            Pour toute question sur l'ordonnance ou sur la prise en charge, merci de contacter le cabinet lors de la prise de rendez-vous.
          </p>
        </div>

        <!-- Q2 -->
        <div class="p-6 bg-background border border-border rounded-xs space-y-2" data-ps="src/pages/faq.astro:2mg1wh">
          <h2 class="font-serif text-lg font-bold text-foreground m-0" data-ps="src/pages/faq.astro:63z1uk">
            Que faut-il apporter pour un bilan podologique ?
          </h2>
          <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/faq.astro:3y7146">
            Merci de vous munir de vos chaussures habituelles et de tout document utile à votre venue.
          </p>
        </div>

        <!-- Q3 -->
        <div class="p-6 bg-background border border-border rounded-xs space-y-2" data-ps="src/pages/faq.astro:2mg1wg">
          <h2 class="font-serif text-lg font-bold text-foreground m-0" data-ps="src/pages/faq.astro:63z1ul">
            Quelle est la durée d'une consultation ?
          </h2>
          <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/faq.astro:3y7147">
            Un soin complet de pédicurie dure en moyenne 45 minutes. Un bilan podologique approfondi requiert entre 45 et 60 minutes selon la complexité de l'examen clinique.
          </p>
        </div>

        <!-- Q4 -->
        <div class="p-6 bg-background border border-border rounded-xs space-y-2" data-ps="src/pages/faq.astro:2mg1wf">
          <h2 class="font-serif text-lg font-bold text-foreground m-0" data-ps="src/pages/faq.astro:63z1um">
            Quel est le délai de fabrication des orthèses plantaires ?
          </h2>
          <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/faq.astro:3y7148">
            Les orthèses plantaires sont confectionnées au cabinet. Le délai est précisé lors du bilan podologique.
          </p>
        </div>

        <!-- Q5 -->
        <div class="p-6 bg-background border border-border rounded-xs space-y-2" data-ps="src/pages/faq.astro:2mg1we">
          <h2 class="font-serif text-lg font-bold text-foreground m-0" data-ps="src/pages/faq.astro:63z1un">
            Comment prendre rendez-vous pour un soin à domicile ?
          </h2>
          <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/faq.astro:3y7149">
            Les soins à domicile étant réservés aux personnes dans l'incapacité de se déplacer à Toulon, la planification s'effectue exclusivement par téléphone au <span class="font-mono text-foreground font-medium" data-ps="src/pages/faq.astro:bw9wbd">{SITE.phone}</span> afin d'évaluer les créneaux d'intervention.
          </p>
        </div>

        <!-- Q6 -->
        <div class="p-6 bg-background border border-border rounded-xs space-y-2" data-ps="src/pages/faq.astro:2mg1wd">
          <h2 class="font-serif text-lg font-bold text-foreground m-0" data-ps="src/pages/faq.astro:63z1uo">
            Le cabinet est-il adapté aux personnes à mobilité réduite ?
          </h2>
          <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/faq.astro:3y714a">
            Oui. Le cabinet est situé au rez-de-chaussée, avec un accès de plain-pied.
          </p>
        </div>

      </div>

      <div class="max-w-3xl mx-auto mt-12 p-6 bg-background border border-border rounded-xs text-center space-y-3" data-ps="src/pages/faq.astro:2mg1wc">
        <h2 class="font-serif text-base font-bold text-foreground m-0" data-ps="src/pages/faq.astro:63z1up">Une autre question ?</h2>
        <p class="text-xs text-muted-foreground m-0" data-ps="src/pages/faq.astro:3y714b">
          Vous pouvez joindre le cabinet par téléphone au <span class="font-mono text-foreground font-semibold" data-ps="src/pages/faq.astro:bw9war">{SITE.phone}</span> pendant les heures d'ouverture.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
