---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
---

<BaseLayout
  title="Honoraires & Tarifs | Camille Durand — Pédicure-Podologue à Toulon"
  description="Tarifs transparents des consultations de pédicurie, bilans podologiques, semelles orthopédiques et soins à domicile. Conventionné Secteur 1."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    name: 'Tarifs et honoraires de consultation',
    description: 'Grille tarifaire des actes de pédicurie-podologie dispensés par Camille Durand à Toulon.',
    url: new URL(Astro.url.pathname, SITE.url).toString(),
  }}
>
  <section class="py-12 md:py-20 bg-background border-b border-border" data-ps="src/pages/honoraires.astro:kgf55x">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8" data-ps="src/pages/honoraires.astro:94ocxh">
      <div class="max-w-3xl space-y-4" data-ps="src/pages/honoraires.astro:94ocxg">
        <h1 class="font-serif text-h1 font-bold text-foreground m-0" data-ps="src/pages/honoraires.astro:7iorkm">
          Honoraires et modalités de règlement
        </h1>
        <p class="text-lg md:text-xl text-muted-foreground leading-relaxed m-0" data-ps="src/pages/honoraires.astro:w5dm2f">
          Transparence tarifaire conforme aux dispositions du Code de la santé publique. Praticien conventionné Secteur 1.
        </p>
      </div>
    </div>
  </section>

  <!-- Tableau des honoraires -->
  <section class="py-16 bg-surface border-b border-border" data-ps="src/pages/honoraires.astro:kgf55b">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8" data-ps="src/pages/honoraires.astro:94ocxf">
      <div class="max-w-4xl mx-auto bg-background border border-border rounded-xs overflow-hidden shadow-xs" data-ps="src/pages/honoraires.astro:94ocxe">
        
        <div class="p-6 md:p-8 border-b border-border bg-surface/50" data-ps="src/pages/honoraires.astro:94ocxd">
          <h2 class="font-serif text-h2 font-bold text-foreground m-0 mb-2" data-ps="src/pages/honoraires.astro:m73os7">
            Grille tarifaire des consultations
          </h2>
          <p class="text-xs text-muted-foreground m-0" data-ps="src/pages/honoraires.astro:w5dm2e">
            Tarifs applicables au cabinet et à domicile à Toulon.
          </p>
        </div>

        <div class="divide-y divide-border" data-ps="src/pages/honoraires.astro:94ocxc">
          
          <div class="p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4" data-ps="src/pages/honoraires.astro:94ocxb">
            <div class="space-y-1" data-ps="src/pages/honoraires.astro:94ocxa">
              <h3 class="font-serif text-base font-bold text-foreground m-0" data-ps="src/pages/honoraires.astro:y5lfz8">Soin de pédicurie médicale au cabinet</h3>
              <p class="text-xs text-muted-foreground m-0" data-ps="src/pages/honoraires.astro:w5dm2d">Traitement des affections cutanées et unguéales (ongles, cors, durillons) · ~45 min</p>
            </div>
            <div class="text-right shrink-0" data-ps="src/pages/honoraires.astro:94ocwo">
              <span class="text-xl font-bold font-mono text-primary" data-ps="src/pages/honoraires.astro:qbfha2">38,00 €</span>
            </div>
          </div>

          <div class="p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4" data-ps="src/pages/honoraires.astro:94ocwn">
            <div class="space-y-1" data-ps="src/pages/honoraires.astro:94ocwm">
              <h3 class="font-serif text-base font-bold text-foreground m-0" data-ps="src/pages/honoraires.astro:y5lfz9">Bilan podologique seul</h3>
              <p class="text-xs text-muted-foreground m-0" data-ps="src/pages/honoraires.astro:w5dm2c">Examen clinique complet en décharge, statique et dynamique · 45 à 60 min</p>
            </div>
            <div class="text-right shrink-0" data-ps="src/pages/honoraires.astro:94ocwl">
              <span class="text-xl font-bold font-mono text-primary" data-ps="src/pages/honoraires.astro:qbfha1">45,00 €</span>
            </div>
          </div>

          <div class="p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4" data-ps="src/pages/honoraires.astro:94ocwk">
            <div class="space-y-1" data-ps="src/pages/honoraires.astro:94ocwj">
              <h3 class="font-serif text-base font-bold text-foreground m-0" data-ps="src/pages/honoraires.astro:y5lfza">Bilan podologique + Semelles orthopédiques sur mesure</h3>
              <p class="text-xs text-muted-foreground m-0" data-ps="src/pages/honoraires.astro:w5dm2b">Comprend le bilan, la fabrication de la paire d'orthèses plantaires et la consultation de contrôle</p>
            </div>
            <div class="text-right shrink-0" data-ps="src/pages/honoraires.astro:94ocwi">
              <span class="text-xl font-bold font-mono text-primary" data-ps="src/pages/honoraires.astro:qbfha0">130,00 € à 160,00 €</span>
            </div>
          </div>

          <div class="p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4" data-ps="src/pages/honoraires.astro:94ocwh">
            <div class="space-y-1" data-ps="src/pages/honoraires.astro:94ocwg">
              <h3 class="font-serif text-base font-bold text-foreground m-0" data-ps="src/pages/honoraires.astro:y5lfzb">Soin de pédicurie à domicile</h3>
              <p class="text-xs text-muted-foreground m-0" data-ps="src/pages/honoraires.astro:w5dm2a">Intervention à Toulon pour personnes à mobilité réduite (frais de déplacement inclus)</p>
            </div>
            <div class="text-right shrink-0" data-ps="src/pages/honoraires.astro:94ocwf">
              <span class="text-xl font-bold font-mono text-primary" data-ps="src/pages/honoraires.astro:qbfh9z">45,00 €</span>
            </div>
          </div>

          <div class="p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4" data-ps="src/pages/honoraires.astro:rsgah5">
            <div class="space-y-1" data-ps="src/pages/honoraires.astro:rsgah4">
              <h3 class="font-serif text-base font-bold text-foreground m-0" data-ps="src/pages/honoraires.astro:y5lfzc">Orthoplastie / Orthonyxie (petit appareillage)</h3>
              <p class="text-xs text-muted-foreground m-0" data-ps="src/pages/honoraires.astro:w5dm29">Correction ou protection d'orteil sur mesure en élastomère de silicone</p>
            </div>
            <div class="text-right shrink-0" data-ps="src/pages/honoraires.astro:rsgah3">
              <span class="text-xl font-bold font-mono text-primary" data-ps="src/pages/honoraires.astro:qbfh9y">30,00 € à 50,00 €</span>
            </div>
          </div>

        </div>

        <div class="p-6 bg-surface border-t border-border text-xs text-muted-foreground space-y-2" data-ps="src/pages/honoraires.astro:rsgah2">
          <p class="font-semibold text-foreground m-0" data-ps="src/pages/honoraires.astro:w5dm28">Prise en charge et remboursement :</p>
          <p class="m-0 leading-relaxed" data-ps="src/pages/honoraires.astro:w5dm27">
            Les semelles orthopédiques font l'objet d'une base de remboursement par la Sécurité Sociale sur prescription médicale de votre médecin traitant. La part complémentaire peut être prise en charge selon votre contrat de mutuelle. Une facture détaillée et une feuille de soins vous sont remises à l'issue de la consultation.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Modes de paiement -->
  <section class="py-16 bg-background" data-ps="src/pages/honoraires.astro:kgf55a">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8" data-ps="src/pages/honoraires.astro:rsgah1">
      <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6" data-ps="src/pages/honoraires.astro:rsgah0">
        
        <div class="p-6 bg-surface border border-border rounded-xs space-y-2 text-center" data-ps="src/pages/honoraires.astro:rsgagz">
          <span class="block text-sm font-bold text-foreground" data-ps="src/pages/honoraires.astro:qbfh9x">Carte Bancaire</span>
          <p class="text-xs text-muted-foreground m-0" data-ps="src/pages/honoraires.astro:w5dm26">Terminal de paiement électronique accepté au cabinet.</p>
        </div>

        <div class="p-6 bg-surface border border-border rounded-xs space-y-2 text-center" data-ps="src/pages/honoraires.astro:rsgagy">
          <span class="block text-sm font-bold text-foreground" data-ps="src/pages/honoraires.astro:qbfh9w">Chèque bancaire</span>
          <p class="text-xs text-muted-foreground m-0" data-ps="src/pages/honoraires.astro:w5dm1k">Chèques libellés à l'ordre de Camille Durand.</p>
        </div>

        <div class="p-6 bg-surface border border-border rounded-xs space-y-2 text-center" data-ps="src/pages/honoraires.astro:rsgagx">
          <span class="block text-sm font-bold text-foreground" data-ps="src/pages/honoraires.astro:qbfh9v">Espèces</span>
          <p class="text-xs text-muted-foreground m-0" data-ps="src/pages/honoraires.astro:w5dm1j">Appoint apprécié pour les règlements en espèces.</p>
        </div>

      </div>

      <div class="max-w-4xl mx-auto mt-8 p-4 border border-border rounded-xs text-xs text-muted-foreground text-center" data-ps="src/pages/honoraires.astro:rsgagw">
        Membre d'une association de gestion agréée par l'administration fiscale, acceptant à ce titre le règlement des honoraires par chèque libellé à son nom ou par carte bancaire.
      </div>
    </div>
  </section>
</BaseLayout>
