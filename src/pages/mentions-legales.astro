---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
---

<BaseLayout
  title="Mentions légales | Camille Durand — Pédicure-Podologue à Toulon"
  description="Mentions légales et informations réglementaires du cabinet de pédicurie-podologie de Camille Durand (EI) à Toulon."
  noIndex={true}
>
  <section class="py-12 md:py-20 bg-background border-b border-border" data-ps="src/pages/mentions-legales.astro:ugckr1">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8" data-ps="src/pages/mentions-legales.astro:ad5qqq">
      <div class="max-w-3xl space-y-4" data-ps="src/pages/mentions-legales.astro:ad5qqr">
        <h1 class="font-serif text-h1 font-bold text-foreground m-0" data-ps="src/pages/mentions-legales.astro:9r18yk">
          Mentions légales & Informations réglementaires
        </h1>
        <p class="text-base md:text-lg text-muted-foreground leading-relaxed m-0" data-ps="src/pages/mentions-legales.astro:hjdv2a">
          Conformément aux dispositions des articles 6-III et 19 de la Loi n° 2004-575 du 21 juin 2004 pour la Confiance dans l'Économie Numérique (L.C.E.N.).
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-surface" data-ps="src/pages/mentions-legales.astro:ugckr2">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8" data-ps="src/pages/mentions-legales.astro:ad5qqs">
      <div class="max-w-3xl mx-auto space-y-8 text-sm text-muted-foreground leading-relaxed" data-ps="src/pages/mentions-legales.astro:ad5qqt">
        
        <!-- Éditeur du site -->
        <div class="p-6 bg-background border border-border rounded-xs space-y-3" data-ps="src/pages/mentions-legales.astro:ad5qqu">
          <h2 class="font-serif text-base font-bold text-foreground m-0" data-ps="src/pages/mentions-legales.astro:4xdo95">
            1. Identification du professionnel de santé
          </h2>
          <p class="m-0" data-ps="src/pages/mentions-legales.astro:hjdv2b">
            <strong>Nom et prénom :</strong> Camille Durand<br />
            <strong>Statut juridique :</strong> Profession libérale en Entreprise Individuelle (EI)<br />
            <strong>Adresse professionnelle :</strong> 12 rue Exemple, 83000 Toulon, France<br />
            <strong>Téléphone :</strong> 04 94 00 00 00<br />
            <strong>Courriel :</strong> camille-durand-pedicure-podologue@exemple.fr
          </p>
        </div>

        <!-- Qualifications et Déontologie -->
        <div class="p-6 bg-background border border-border rounded-xs space-y-3" data-ps="src/pages/mentions-legales.astro:ad5qqv">
          <h2 class="font-serif text-base font-bold text-foreground m-0" data-ps="src/pages/mentions-legales.astro:4xdo94">
            2. Titres professionnels et autorité de régulation
          </h2>
          <p class="m-0" data-ps="src/pages/mentions-legales.astro:hjdv2c">
            <strong>Titre professionnel :</strong> Pédicure-podologue Diplômé d'État (Diplôme délivré en France par un institut de formation agréé (nom à compléter))<br />
            <strong>Ordre professionnel :</strong> Inscrite au tableau de l'Ordre National des Pédicures-Podologues (ONPP)<br />
            <strong>Numéro RPPS :</strong> 00000000000 (fictif)<br />
            <strong>Réglementation applicable :</strong> Profession de santé réglementée par le Code de la santé publique (articles L. 4322-1 et suivants et R. 4322-1 et suivants relatifs aux règles professionnelles).
          </p>
        </div>

        <!-- Conventionnement -->
        <div class="p-6 bg-background border border-border rounded-xs space-y-3" data-ps="src/pages/mentions-legales.astro:ad5qqw">
          <h2 class="font-serif text-base font-bold text-foreground m-0" data-ps="src/pages/mentions-legales.astro:4xdo93">
            3. Conventionnement de l'Assurance Maladie
          </h2>
          <p class="m-0" data-ps="src/pages/mentions-legales.astro:hjdv2d">
            Praticien conventionné avec l'Assurance Maladie (Caisse Primaire d'Assurance Maladie du Var). Les tarifs applicables sont affichés au cabinet et consultables sur la page « Honoraires » de ce site.
          </p>
        </div>

        <!-- Hébergement -->
        <div class="p-6 bg-background border border-border rounded-xs space-y-3" data-ps="src/pages/mentions-legales.astro:ad5qqx">
          <h2 class="font-serif text-base font-bold text-foreground m-0" data-ps="src/pages/mentions-legales.astro:4xdo92">
            4. Hébergement du site
          </h2>
          <p class="m-0" data-ps="src/pages/mentions-legales.astro:hjdv2z">
            Ce site est hébergé sur une infrastructure Cloud sécurisée conforme aux normes de protection des données européennes.
          </p>
        </div>

        <!-- Propriété intellectuelle -->
        <div class="p-6 bg-background border border-border rounded-xs space-y-3" data-ps="src/pages/mentions-legales.astro:ad5qqy">
          <h2 class="font-serif text-base font-bold text-foreground m-0" data-ps="src/pages/mentions-legales.astro:4xdo91">
            5. Propriété intellectuelle et déontologie de communication
          </h2>
          <p class="m-0" data-ps="src/pages/mentions-legales.astro:hjdv30">
            Le contenu de ce site a pour unique vocation l'information loyale, claire et mesurée du public sur la nature des soins dispensés, l'organisation du cabinet et ses conditions d'accès, conformément à l'article R. 4322-39 du Code de la santé publique. Tout procédé publicitaire direct ou indirect est proscrit.
          </p>
        </div>

        <!-- Clause de démonstration obligatoire -->
        <div class="p-4 bg-surface border border-border rounded-xs text-xs text-muted-foreground text-center font-semibold" data-ps="src/pages/mentions-legales.astro:ad5qqz">
          Cabinet fictif à visée de démonstration.
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
