---
import { SITE } from '@/config/site';
---

<footer class="bg-dark-background text-dark-foreground border-t border-dark-border mt-16 md:mt-24" data-ps="src/components/Footer.astro:7iejvu">
  <div class="max-w-screen-xl mx-auto px-4 md:px-8 py-12 md:py-16" data-ps="src/components/Footer.astro:256hn1">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 pb-12 border-b border-dark-border" data-ps="src/components/Footer.astro:256hn0">
      
      <!-- Praticien & Identification légale -->
      <div class="space-y-3" data-ps="src/components/Footer.astro:256hmz">
        <h2 class="font-serif text-lg font-bold text-dark-foreground tracking-tight m-0" data-ps="src/components/Footer.astro:w7klom">
          Camille Durand
        </h2>
        <p class="text-xs uppercase tracking-wider text-dark-muted-foreground font-semibold" data-ps="src/components/Footer.astro:csf9p">
          Pédicure-Podologue (EI)
        </p>
        <p class="text-sm text-dark-muted-foreground leading-relaxed" data-ps="src/components/Footer.astro:csf9q">
          Diplôme d'État de Pédicure-Podologue — IFPP Marseille.<br />
          Exercice libéral réglementé par le Code de la santé publique.
        </p>
        <div class="text-xs text-dark-muted-foreground space-y-1 pt-1 font-mono" data-ps="src/components/Footer.astro:256hmy">
          <div data-ps="src/components/Footer.astro:p4vf82">N° RPPS : {SITE.rpps}</div>
          <div data-ps="src/components/Footer.astro:p4vf83">N° ADELI : {SITE.adeli}</div>
          <div data-ps="src/components/Footer.astro:p4vf84">Conventionné Secteur 1</div>
        </div>
      </div>

      <!-- Coordonnées & Accès -->
      <div class="space-y-3" data-ps="src/components/Footer.astro:p4vf85">
        <h2 class="font-serif text-base font-bold text-dark-foreground m-0" data-ps="src/components/Footer.astro:w7klon">
          Cabinet & Coordonnées
        </h2>
        <address class="not-italic text-sm text-dark-muted-foreground space-y-1.5 leading-relaxed">
          <p class="m-0 font-medium text-dark-foreground" data-ps="src/components/Footer.astro:csf9r">{SITE.address.street}</p>
          <p class="m-0" data-ps="src/components/Footer.astro:csf9s">{SITE.address.postalCode} {SITE.address.city}</p>
          <p class="m-0 text-xs text-dark-muted-foreground pt-1" data-ps="src/components/Footer.astro:csf9t">{SITE.address.access}</p>
          <p class="m-0 pt-2 font-mono text-dark-foreground" data-ps="src/components/Footer.astro:csf9u">Tél. {SITE.phone}</p>
        </address>
        <div class="pt-1" data-ps="src/components/Footer.astro:p4vf86">
          <a
            href={SITE.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block text-xs font-semibold px-3 py-1.5 bg-primary text-primary-foreground rounded-xs hover:bg-primary-hover transition-colors"
           data-ps="src/components/Footer.astro:7gqbxx">
            Prendre rendez-vous en ligne
          </a>
        </div>
      </div>

      <!-- Horaires d'ouverture -->
      <div class="space-y-3" data-ps="src/components/Footer.astro:p4vf87">
        <h2 class="font-serif text-base font-bold text-dark-foreground m-0" data-ps="src/components/Footer.astro:w7kloo">
          Horaires de consultation
        </h2>
        <ul class="list-none p-0 m-0 text-sm text-dark-muted-foreground space-y-2">
          <li class="flex flex-col" data-ps="src/components/Footer.astro:wyji3x">
            <span class="font-medium text-dark-foreground" data-ps="src/components/Footer.astro:abywy3">Lundi au Vendredi</span>
            <span class="text-xs" data-ps="src/components/Footer.astro:abywy4">8h30 – 19h00 (sur RDV)</span>
          </li>
          <li class="flex flex-col" data-ps="src/components/Footer.astro:wyji3y">
            <span class="font-medium text-dark-foreground" data-ps="src/components/Footer.astro:abywy5">Samedi matin</span>
            <span class="text-xs" data-ps="src/components/Footer.astro:abywy6">8h30 – 12h30 (sur RDV)</span>
          </li>
          <li class="flex flex-col" data-ps="src/components/Footer.astro:wyji3z">
            <span class="font-medium text-dark-foreground" data-ps="src/components/Footer.astro:abywy7">Soins à domicile</span>
            <span class="text-xs" data-ps="src/components/Footer.astro:abywy8">Sur demande (Toulon et proximité immédiate)</span>
          </li>
        </ul>
      </div>

      <!-- Plan du site & Liens -->
      <div class="space-y-3" data-ps="src/components/Footer.astro:p4vf88">
        <h2 class="font-serif text-base font-bold text-dark-foreground m-0" data-ps="src/components/Footer.astro:w7klop">
          Plan du site
        </h2>
        <ul class="list-none p-0 m-0 space-y-1.5 text-sm">
          <li data-ps="src/components/Footer.astro:wyji40"><a href="/" class="text-dark-muted-foreground hover:text-dark-foreground no-underline transition-colors" data-ps="src/components/Footer.astro:7gqbxy">Accueil</a></li>
          <li data-ps="src/components/Footer.astro:wyji41"><a href="/soins" class="text-dark-muted-foreground hover:text-dark-foreground no-underline transition-colors" data-ps="src/components/Footer.astro:7gqbxz">Soins & Modalités</a></li>
          <li data-ps="src/components/Footer.astro:wyji42"><a href="/le-cabinet" class="text-dark-muted-foreground hover:text-dark-foreground no-underline transition-colors" data-ps="src/components/Footer.astro:7gqby0">Le cabinet & Hygiène</a></li>
          <li data-ps="src/components/Footer.astro:wyji4o"><a href="/honoraires" class="text-dark-muted-foreground hover:text-dark-foreground no-underline transition-colors" data-ps="src/components/Footer.astro:7gqby1">Honoraires & Tarifs</a></li>
          <li data-ps="src/components/Footer.astro:wyji4p"><a href="/faq" class="text-dark-muted-foreground hover:text-dark-foreground no-underline transition-colors" data-ps="src/components/Footer.astro:7gqbyn">Questions fréquentes</a></li>
          <li data-ps="src/components/Footer.astro:wyji4q"><a href="/contact" class="text-dark-muted-foreground hover:text-dark-foreground no-underline transition-colors" data-ps="src/components/Footer.astro:7gqbyo">Accès & Contact</a></li>
          <li data-ps="src/components/Footer.astro:wyji4r"><a href="/mentions-legales" class="text-dark-muted-foreground hover:text-dark-foreground no-underline transition-colors" data-ps="src/components/Footer.astro:7gqbyp">Mentions légales</a></li>
          <li data-ps="src/components/Footer.astro:wyji4s"><a href="/confidentialite" class="text-dark-muted-foreground hover:text-dark-foreground no-underline transition-colors" data-ps="src/components/Footer.astro:7gqbyq">Politique de confidentialité</a></li>
        </ul>
      </div>
    </div>

    <!-- Avertissement de messagerie & Mention légale obligatoire -->
    <div class="pt-8 pb-4 text-xs text-dark-muted-foreground space-y-3" data-ps="src/components/Footer.astro:p4vf89">
      <div class="p-3 bg-dark-background/60 border border-dark-border rounded-xs" data-ps="src/components/Footer.astro:p4vf8a">
        <p class="m-0 font-medium text-dark-foreground mb-1" data-ps="src/components/Footer.astro:csf9v">Information relative aux correspondances électroniques :</p>
        <p class="m-0 text-dark-muted-foreground leading-relaxed" data-ps="src/components/Footer.astro:csf9w">
          Courriel : <span class="font-mono text-dark-foreground" data-ps="src/components/Footer.astro:abywyu">{SITE.email}</span> — La messagerie utilisée n'est pas sécurisée. Pour toute demande relative à un dossier médical, merci de contacter directement le cabinet par téléphone ou lors de votre consultation.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-dark-border text-xs text-dark-muted-foreground" data-ps="src/components/Footer.astro:p4vf8b">
        <p class="m-0 font-semibold text-dark-foreground" data-ps="src/components/Footer.astro:csf9x">
          Cabinet fictif à visée de démonstration.
        </p>
        <p class="m-0" data-ps="src/components/Footer.astro:csfaj">
          © {new Date().getFullYear()} Camille Durand (EI) — Tous droits réservés.
        </p>
      </div>
    </div>
  </div>
</footer>
